# Local development template only. Never commit a real .env file.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
# Required by the server for durable checkout cleanup and email outbox processing.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Razorpay: use test credentials locally first, then live credentials in production.
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_RAZORPAY_KEY_SECRET

# PayPal REST API. Sandbox: https://api-m.sandbox.paypal.com
# Production: https://api-m.paypal.com
PAYPAL_CLIENT_ID=REPLACE_WITH_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=REPLACE_WITH_PAYPAL_CLIENT_SECRET
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Resend server-side email delivery.
RESEND_API_KEY=re_REPLACE_WITH_RESEND_API_KEY
EMAIL_FROM=ECU FILE SERVICE INDIA <noreply@YOUR_VERIFIED_DOMAIN>
ADMIN_NOTIFICATION_EMAIL=YOUR_ADMIN_EMAIL@example.com

# Separate server proof secret. Store the same value in Supabase Vault as
# efsi_payment_gate_proof_secret. Minimum 32 characters.
PAYMENT_GATE_PROOF_SECRET=REPLACE_WITH_A_RANDOM_32_PLUS_CHARACTER_SECRET
# true only after the final payment/check-out migration and Vault secret are applied.
PAYMENT_GATE_SCHEMA_READY=false

PUBLIC_APP_URL=https://ecufileservice.in
PORT=4173
NODE_ENV=development
