# LOCAL DEVELOPMENT TEMPLATE ONLY. Copy to .env for local runs. Never add real credentials to source control.
PORT=4173
NODE_ENV=development
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_PRIVATE_SERVICE_ROLE_KEY
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_WITH_RAZORPAY_SECRET
PAYPAL_CLIENT_ID=REPLACE_WITH_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=REPLACE_WITH_PAYPAL_SECRET
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
RESEND_API_KEY=re_REPLACE_WITH_RESEND_API_KEY
EMAIL_FROM=ECU SOLUTION <noreply@your-verified-domain.example>
ADMIN_NOTIFICATION_EMAIL=admin@example.com
PAYMENT_GATE_PROOF_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PAYMENT_GATE_SCHEMA_READY=false
PUBLIC_APP_URL=http://127.0.0.1:4173
