# Copy to .env in F:\web and fill from your Supabase project's API settings.
# SUPABASE_URL is your project URL. SUPABASE_ANON_KEY is the publishable/anon key.
# Never put a service_role or secret key here or in browser code.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Add Razorpay API credentials in the local .env file only. Use Test Mode first.
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_KEY_SECRET
# Generate a separate random 32+ character proof secret locally; also store it in Supabase Vault.
PAYMENT_GATE_PROOF_SECRET=REPLACE_WITH_LOCALLY_GENERATED_RANDOM_SECRET
# Keep false until a reviewed Supabase payment-gate migration closes direct RLS upload bypasses.
PAYMENT_GATE_SCHEMA_READY=false
# Optional: use a persistent private directory for payment state in deployment.
# PAYMENT_STATE_DIR=
PORT=4173
